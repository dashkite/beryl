doctype html

html
  head
    include templates/head

  body
    
    main
      main
        if navigation
          .block( class = "nav widest center" )
            nav(style="--block-nav-flex-direction: column; align-items: center;")
              header 
                h2 Root Schema   
              .nav-items
                a(href=navigation.root.href)= navigation.root.text
          if navigation.subschemas && navigation.subschemas.length > 0
            .block( class = "nav widest center" )
              nav(style="--block-nav-flex-direction: column; align-items: center;")
                header 
                  h2 Subschemas 
                .nav-items  
                  for sec in navigation.subschemas
                    a(href=sec.href)= sec.text
        include templates/resolve
