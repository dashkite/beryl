mixin prose({ iterable, heading, id, isRoot, isArray, isPatternProperties })
  if heading
    if isRoot
      h1(id=id)= heading
    else
      h2(id=id)= heading
    - var typeStr = formatType(iterable, null)
    p
      strong Type: 
      em= typeStr
      | . 
      if iterable.description
        = iterable.description.value

  ul
    for property, propertyName in iterable
      if !heading || (propertyName !== "title" && propertyName !== "description" && propertyName !== "properties" && propertyName !== "type")
        li
          if !isArray
            if isPatternProperties
              strong
                code= propertyName
                | : 
            else
              strong= propertyName + ": "
          if propertyName == "$ref"
            - var refVal = property.value
            a(href=refVal)= getHeadingName(refVal, refs[refVal.slice(1)])
          else if property.Ctype == "string"
            if propertyName == "pattern"
              code= property.value
            else
              = property.value
          else if property.Ctype == "number"
            = property.value
          else if property.Ctype == "boolean"
            = property.value
          else if property.Ctype == "object"
            if property.value.$ref
              - var refVal = property.value.$ref.value
              a(href=refVal)= getHeadingName(refVal, refs[refVal.slice(1)])
            else
              +prose({ iterable: property.value, isPatternProperties: (propertyName == "patternProperties") })
          else if property.Ctype == "array"
            +prose({ iterable: property.value, isArray: true })

  if heading && iterable.properties
    h3 Properties
    for prop, propName in iterable.properties.value
      h4= getHeadingName(propName, prop.value)
      if prop.Ctype == "object" && prop.value.$ref
        - var refVal = prop.value.$ref.value
        - var refSchema = refs[refVal.slice(1)]
        - var typeStr = formatType(prop.value, refSchema)
        - var desc = prop.value.description ? prop.value.description.value : (refSchema ? refSchema.description?.value : null)
        p
          strong Type: 
          em= typeStr
          | . 
          if desc
            = desc
        p
          | See 
          a(href=refVal)= getHeadingName(refVal, refSchema)
          | .
      else
        - var typeStr = formatType(prop.value, null)
        - var desc = prop.value.description ? prop.value.description.value : null
        p
          strong Type: 
          em= typeStr
          | . 
          if desc
            = desc
        ul
          for value, key in prop.value
            if key !== "title" && key !== "description" && key !== "type"
              li
                if isPatternProperties
                  strong
                    code= key
                    | : 
                else
                  strong= key + ": "
                if value.Ctype == "string"
                  if key == "pattern"
                    code= value.value
                  else
                    = value.value
                else if value.Ctype == "number"
                  = value.value
                else if value.Ctype == "boolean"
                  = value.value
                else if value.Ctype == "object"
                  if value.value.$ref
                    - var refVal = value.value.$ref.value
                    a(href=refVal)= getHeadingName(refVal, refs[refVal.slice(1)])
                  else
                    +prose({ iterable: value.value, isPatternProperties: (key == "patternProperties") })
                else if value.Ctype == "array"
                  +prose({ iterable: value.value, isArray: true })
