mixin proseSection(section, subschemas)
  if section.isRoot
    h1(id=section.id)= section.heading
    if subschemas && subschemas.length > 0
      p.toc
        for sec, index in subschemas
          if index > 0
            |  | 
          a(href=`#${sec.id}`)= sec.heading
  else
    h2(id=section.id)= section.heading
    
  if section.description
    p= section.description
    
  if section.tableRows && section.tableRows.length > 0
    table
      thead
        tr
          th Name
          th Value
      tbody
        for row in section.tableRows
          tr
            td!= row.label
            td!= row.value
            
  for ref in section.references
    p See: <a href="#{ref.href}">#{ref.text}</a>
    
  if section.properties && section.properties.length > 0
    h3 Properties
    for prop in section.properties
      if prop.isPattern
        h4(id=prop.id)
          | Properties matching 
          code= prop.heading
      else
        h4(id=prop.id)= prop.heading
        
      if prop.description
        p= prop.description
        
      if prop.tableRows && prop.tableRows.length > 0
        table
          thead
            tr
              th Name
              th Value
          tbody
            for row in prop.tableRows
              tr
                td!= row.label
                td!= row.value
                
      for ref in prop.references
        p See: <a href="#{ref.href}">#{ref.text}</a>
