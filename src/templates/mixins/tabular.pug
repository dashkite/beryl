mixin tabular(model, id)
  .block(class="table round")
    section 
      table(id=id) 
        tbody
          for row in model.rows
            tr
              if row.isRef
                td(style="border: none;")
                  a(href=row.href) Go to Reference
              else
                if !model.isArray 
                  th= row.name
                if row.type == "simple" 
                  td
                    p= row.value 
                else if row.type == "object"
                  td
                    +tabular(row.value)
                else if row.type == "array"
                  td 
                    +tabular(row.value)
