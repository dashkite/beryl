mixin schemaTable(iterable, refSchema)
  - var rows = []
  for property, propertyName in iterable
    if propertyName !== "title" && propertyName !== "description" && propertyName !== "properties" && propertyName !== "patternProperties"
      if propertyName == "items" && property.Ctype == "object" && property.value.$ref
        - continue
      if propertyName == "$ref"
        - continue
      - var label = getPropertyLabel(propertyName)
      - var value = formatPropertyVal(propertyName, property, refs)
      if value !== ""
        - rows.push({ label: label, value: value })

  if iterable.patternProperties
    for patternSchema, pattern in iterable.patternProperties.value
      - var label = `<code>${pattern}</code>`
      - var value = formatPropertyVal(pattern, patternSchema, refs)
      if value !== ""
        - rows.push({ label: label, value: value })

  if rows.length > 0
    table
      thead
        tr
          th Name
          th Value
      tbody
        for row in rows
          tr
            td: strong!= row.label
            td!= row.value

mixin schemaReferences(iterable)
  if iterable.$ref
    - var refVal = iterable.$ref.value
    - var refObj = refs[refVal.slice(1)]
    - var rSchema = refObj ? refObj.value : null
    - var headingName = getHeadingName(refVal, rSchema)
    - var slug = slugify(headingName)
    p See: <a href="##{slug}">#{headingName}</a>
  if iterable.items && iterable.items.Ctype == "object" && iterable.items.value.$ref
    - var refVal = iterable.items.value.$ref.value
    - var refObj = refs[refVal.slice(1)]
    - var rSchema = refObj ? refObj.value : null
    - var headingName = getHeadingName(refVal, rSchema)
    - var slug = slugify(headingName)
    p See: <a href="##{slug}">#{headingName}</a>

mixin proseProperty(propName, prop, isPattern)
  if isPattern
    h4: code= propName
  else
    h4= getHeadingName(propName, prop.value)

  - var desc = prop.value.description ? prop.value.description.value : null
  if prop.Ctype == "object" && prop.value.$ref
    - var refVal = prop.value.$ref.value
    - var refObj = refs[refVal.slice(1)]
    - var refSchema = refObj ? refObj.value : null
    - desc = desc || (refSchema && refSchema.description ? refSchema.description.value : null)

  if desc
    p= desc

  if !(prop.Ctype == "object" && prop.value.$ref)
    +schemaTable(prop.value, null)

  +schemaReferences(prop.value)

mixin prose({ iterable, heading, id, isRoot })
  if heading
    if isRoot
      h1(id=id)= heading
    else
      h2(id=id)= heading
    if iterable.description
      p= iterable.description.value

  +schemaTable(iterable, null)
  +schemaReferences(iterable)

  if heading && iterable.properties
    h3 Properties
    for prop, propName in iterable.properties.value
      +proseProperty(propName, prop, false)
