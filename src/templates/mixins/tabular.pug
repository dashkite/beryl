mixin tabular({ iterable, id, isArray })
  .block(class="table round")
    section 
      table(id=id) 
        tbody
          for property, propertyName in iterable 
            tr
              if propertyName == "$ref"
                td(style="border: none;")
                  a(href=property.value) Go to Reference
              else
                if !isArray 
                  th=propertyName
                if property.Ctype == "string" 
                  td
                    p=property.value 
                else if property.Ctype == "number" 
                  td
                    p=property.value 
                else if property.Ctype == "boolean"
                  td
                    p=property.value 
                else if property.Ctype == "object"
                  td
                    +tabular({ iterable: property.value })
                else if property.Ctype == "array"
                  td 
                    +tabular({ iterable: property.value, isArray: true })
